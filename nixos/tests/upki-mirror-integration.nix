{ pkgs, ... }:

let
  recordsHost = "firefox.settings.services.mozilla.com";
  attachmentsHost = "firefox-settings-attachments.cdn.mozilla.net";
  mirrorHost = "upki.test";

  # Generated by upki-mirror's build_filter test helper. This is a valid v3
  # CRLite filter; the mirror converts it to the v4 format served to clients.
  filterBase64 = pkgs.writeText "test.filter.base64" ''
    AwABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAADQBwAAAAAA
    AAEAAAAAAAAAIAAAAAAAAACqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqgEAAAAAAAAA
    AgAAAAAAAAAHAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAHAAAAAAAAAAIAAAAAAAAA
    XBRrpI0n8z0BAAAAAAAAAAIAAAAAAAAACuwZAP1Ocq0BAAAAAAAAAAIAAAAAAAAA9jm8sxsMEP8B
    AAAAAAAAAAIAAAAAAAAANPplPF+N5Z4BAAAAAAAAAAEAAAAAAAAAkgnqGmLvZHgCAAAAAAAAAJco
    87zXRSicAQAAAAAAAAABAAAAAAAAABkpluwuXmooAQAAAAAAAAA0AAAAAAAAAA==
  '';

  records = pkgs.writeText "records" (
    builtins.toJSON {
      data = [
        {
          attachment = {
            filename = "test.filter";
            hash = "fb26712b91ac0d009c1f7553b5fdd6e79c987804f15f6a4db9ccb9c6331e7d07";
            location = "security-state/test.filter";
            size = 331;
          };
          channel = "default";
          id = "full";
          incremental = false;
          parent = null;
        }
      ];
    }
  );

  mozillaFixture = pkgs.runCommand "upki-mozilla-fixture" { } ''
    mkdir -p \
      "$out/v1/buckets/security-state/collections/cert-revocations" \
      "$out/security-state"
    cp ${records} \
      "$out/v1/buckets/security-state/collections/cert-revocations/records"
    base64 --decode ${filterBase64} > "$out/security-state/test.filter"
  '';

  certConfig = pkgs.writeText "upki-test-cert.conf" ''
    basicConstraints=critical,CA:FALSE
    keyUsage=critical,digitalSignature,keyEncipherment
    extendedKeyUsage=serverAuth
    subjectAltName=DNS:${recordsHost},DNS:${attachmentsHost}
  '';

  testCertificates =
    pkgs.runCommand "upki-test-certificates"
      {
        nativeBuildInputs = [ pkgs.openssl ];
      }
      ''
        mkdir "$out"
        openssl req -new -nodes -x509 \
          -keyout "$out/ca.key" -out "$out/ca.crt" -days 3650 \
          -subj "/CN=UPKI test CA" \
          -addext "basicConstraints=critical,CA:TRUE" \
          -addext "keyUsage=critical,keyCertSign,cRLSign"
        openssl req -new -nodes -newkey rsa:2048 \
          -keyout "$out/server.key" -out server.csr \
          -subj "/CN=${recordsHost}"
        openssl x509 -req -in server.csr \
          -CA "$out/ca.crt" -CAkey "$out/ca.key" -CAcreateserial \
          -out "$out/server.crt" -days 3650 -extfile ${certConfig}
      '';
in
{
  name = "upki-mirror-integration";

  meta.maintainers = [ pkgs.lib.maintainers.cpu ];

  nodes = {
    mirror = {
      networking = {
        firewall.allowedTCPPorts = [
          80
          443
        ];
        hosts."127.0.0.1" = [
          recordsHost
          attachmentsHost
        ];
      };

      security.pki.certificateFiles = [ "${testCertificates}/ca.crt" ];

      services.upki-mirror = {
        enable = true;
        manifestComment = "NixOS integration test";
        nginx = {
          enable = true;
          domain = mirrorHost;
        };
      };

      services.nginx.virtualHosts = {
        ${recordsHost} = {
          addSSL = true;
          sslCertificate = "${testCertificates}/server.crt";
          sslCertificateKey = "${testCertificates}/server.key";
          root = mozillaFixture;
        };
        ${attachmentsHost} = {
          addSSL = true;
          sslCertificate = "${testCertificates}/server.crt";
          sslCertificateKey = "${testCertificates}/server.key";
          root = mozillaFixture;
        };
      };
    };

    client =
      { nodes, ... }:
      {
        networking.hosts."${nodes.mirror.networking.primaryIPAddress}" = [ mirrorHost ];

        services.upki = {
          enable = true;
          settings.revocation.fetch-url = "http://${mirrorHost}/revocation/";
        };
      };
  };

  testScript = ''
    start_all()

    mirror.wait_for_unit("nginx.service")
    mirror.succeed("systemctl start upki-mirror.service")
    mirror.succeed(
        "grep --fixed-strings 'NixOS integration test' "
        "/var/lib/upki-mirror/revocation/manifest.json"
    )
    mirror.succeed(
        "test \"$(od --address-radix=n --format=x1 --read-bytes=2 "
        "/var/lib/upki-mirror/revocation/test.filter | tr --delete ' ')\" = 0400"
    )

    client.wait_for_unit("upki-fetch.timer")
    client.succeed("systemctl start upki-fetch.service")
    client.succeed("test -s /var/cache/upki/revocation/index.bin")
    client.succeed("upki --config-file /etc/upki/config.toml verify")

    mirror_hash = mirror.succeed(
        "sha256sum /var/lib/upki-mirror/revocation/test.filter"
    ).split()[0]
    client_hash = client.succeed(
        "sha256sum /var/cache/upki/revocation/test.filter"
    ).split()[0]
    assert mirror_hash == client_hash

    client.succeed("systemctl start upki-fetch.service")
    mirror.succeed(
        "grep --extended-regexp "
        "'GET /revocation/manifest\\.json HTTP/1\\.[01].* 304 ' "
        "/var/log/nginx/access.log"
    )
  '';
}
